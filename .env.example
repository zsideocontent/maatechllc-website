# Copy to .env.local for local dev. In production these are set as
# environment variables in the Vercel project dashboard.

# Upwork API OAuth2 credentials (app: MAA Tech / maatechllc.com)
# Used by app/oauth/upwork/callback/route.ts to exchange an authorization
# code for an access token + refresh token.
# Get these from Upwork's developer portal once the API key application is
# approved. Redirect/callback URL registered with Upwork must be exactly:
# https://maatechllc.com/oauth/upwork/callback
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
